generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GESTOR_CONTRATO
  FISCAL_ADM
  FISCAL_TECNICO
  FISCAL_SETORIAL
  DEMANDANTE
  EMPRESA
}

enum StatusChamado {
  ABERTO
  RECEBIDO
  EM_ORCAMENTO
  AGUARDANDO_AUTORIZACAO
  AUTORIZADO
  RECUSADO
  BLOQUEADO_SEM_SALDO
  EM_EXECUCAO
  ATENDIDO
  DEVOLVIDO
  EM_GARANTIA
  REABERTO_GARANTIA
  CONCLUIDO
}

enum TipoFoto {
  ANTES
  DEPOIS
  COMPROVANTE
}

enum TipoInsumo {
  PREVISTO
  EXECUTADO
}

model Usuario {
  id              String   @id @default(uuid())
  nome            String
  email           String   @unique
  senhaHash       String
  role            Role     @default(DEMANDANTE)
  matricula       String?
  telefone        String?
  ativo           Boolean  @default(true)
  deveTrocarSenha Boolean  @default(true)

  unidadeId       String?
  unidade         Unidade? @relation(fields: [unidadeId], references: [id])

  empresaId       String?
  empresa         Empresa? @relation(fields: [empresaId], references: [id])

  chamadosAbertos     Chamado[]            @relation("ChamadosAbertos")
  chamadosAutorizados ChamadoAutorizacao[]
  unidadesFiscais     FiscalSetorialUnidade[]

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@map("usuarios")
}

model Unidade {
  id        String   @id @default(uuid())
  nome      String
  sigla     String   @unique
  campus    String
  codigo    String?  @unique
  ativo     Boolean  @default(true)

  predios          CidadePredio[]
  usuarios         Usuario[]
  chamados         Chamado[]
  contratoUnidades ContratoUnidade[]
  fiscaisSetoriais FiscalSetorialUnidade[]

  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("unidades")
}

model CidadePredio {
  id        String   @id @default(uuid())
  unidadeId String
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  nome      String
  endereco  String?
  ativo     Boolean  @default(true)

  chamados  Chamado[]

  criadoEm  DateTime @default(now())

  @@map("cidade_predios")
}

model FiscalSetorialUnidade {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidadeId String
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, unidadeId])
  @@map("fiscais_setoriais_unidades")
}

model Empresa {
  id           String   @id @default(uuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String   @unique
  email        String
  telefone     String?
  ativo        Boolean  @default(true)

  usuarios      Usuario[]
  funcionarios  FuncionarioEmpresa[]
  contratos     Contrato[]
  chamados      Chamado[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("empresas")
}

model FuncionarioEmpresa {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  cpf       String   @unique
  cargo     String
  ativo     Boolean  @default(true)

  criadoEm  DateTime @default(now())

  @@map("funcionarios_empresas")
}

model Contrato {
  id              String   @id @default(uuid())
  numero          String
  ano             Int
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  objeto          String
  dataInicio      DateTime
  dataFim         DateTime
  valorTotal      Decimal  @db.Decimal(14, 2)
  saldoDisponivel Decimal  @db.Decimal(14, 2)
  ativo           Boolean  @default(true)

  aditivos        ContratoAditivo[]
  unidades        ContratoUnidade[]

  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([numero, ano])
  @@map("contratos")
}

model ContratoAditivo {
  id             String   @id @default(uuid())
  contratoId     String
  contrato       Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero         Int
  tipo           String   // VALOR, PRAZO, MISTO
  valorAjuste    Decimal? @db.Decimal(14, 2)
  novaDataFim    DateTime?
  dataAssinatura DateTime
  objeto         String?

  criadoEm       DateTime @default(now())

  @@map("contrato_aditivos")
}

model ContratoUnidade {
  id              String   @id @default(uuid())
  contratoId      String
  contrato        Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  unidadeId       String
  unidade         Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cotaMensal      Decimal  @db.Decimal(14, 2)
  cotaAnual       Decimal  @db.Decimal(14, 2)
  saldoDisponivel Decimal  @db.Decimal(14, 2)

  @@unique([contratoId, unidadeId])
  @@map("contrato_unidades")
}

model CategoriaServico {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String?
  icone     String?

  tipos     TipoServico[]

  @@map("categorias_servicos")
}

model TipoServico {
  id                  Int              @id @default(autoincrement())
  categoriaId         Int
  categoria           CategoriaServico @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nome                String
  descricao           String?
  prazoEstimadoHoras  Int              @default(72)

  chamados            Chamado[]

  @@map("tipos_servicos")
}

model TipoAmbiente {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String?

  chamados  Chamado[]

  @@map("tipos_ambientes")
}

model FraseUrgencia {
  id            Int       @id @default(autoincrement())
  frase         String    @unique
  nivelSugerido Int       @default(3) // 1=Crítico a 5=Planejado
  peso          Int       @default(1)

  chamados      Chamado[]

  @@map("frases_urgencias")
}

model TabelaReferencia {
  id             String          @id @default(uuid())
  nome           String          // Ex: SINAPI-RN, TABELA_PROPRIAD_UERN
  versao         String          // Ex: 2026/01
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  ativa          Boolean         @default(true)

  itens          ItemReferencia[]

  criadoEm       DateTime        @default(now())

  @@map("tabelas_referencias")
}

model ItemReferencia {
  id             String           @id @default(uuid())
  tabelaId       String
  tabela         TabelaReferencia @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  codigo         String
  descricao      String
  unidadeMedida  String           // m², m, un, vb, etc
  precoUnitario  Decimal          @db.Decimal(12, 2)

  insumos        ChamadoInsumo[]

  @@unique([tabelaId, codigo])
  @@map("itens_referencias")
}

model Chamado {
  id                 String             @id @default(uuid())
  numero             Int                @default(autoincrement()) @unique
  titulo             String?
  setorEspecifico    String
  descricao          String             @db.Text
  nivelCodigo        String             @default("NORMAL")
  nivelOrdem         Int                @default(3) // 1=Crítico, 2=Alto, 3=Médio, 4=Baixo, 5=Planejado
  status             StatusChamado      @default(ABERTO)

  unidadeId          String
  unidade            Unidade            @relation(fields: [unidadeId], references: [id])

  predioId           String?
  predio             CidadePredio?      @relation(fields: [predioId], references: [id])

  tipoAmbienteId     Int
  tipoAmbiente       TipoAmbiente       @relation(fields: [tipoAmbienteId], references: [id])

  tipoServicoId      Int
  tipoServico        TipoServico        @relation(fields: [tipoServicoId], references: [id])

  fraseUrgenciaId    Int?
  fraseUrgencia      FraseUrgencia?     @relation(fields: [fraseUrgenciaId], references: [id])

  abertoPorId        String
  abertoPor          Usuario            @relation("ChamadosAbertos", fields: [abertoPorId], references: [id])

  empresaId          String?
  empresa            Empresa?           @relation(fields: [empresaId], references: [id])

  dataEsperada       DateTime?
  prazoLimite        DateTime?
  abertoEm           DateTime           @default(now())
  autorizadoEm       DateTime?
  atendidoEm         DateTime?
  concluidoEm        DateTime?
  garantiaAte        DateTime?

  valorOrcado        Decimal?           @db.Decimal(12, 2)
  valorAutorizado    Decimal?           @db.Decimal(12, 2)
  justificativaRecusa String?           @db.Text

  // Avaliação do demandante
  avaliacaoNota      Int?
  avaliacaoComentario String?          @db.Text
  ocorrenciasGarantia String?          @db.Text

  fotos              ChamadoFoto[]
  insumos            ChamadoInsumo[]
  autorizacoes       ChamadoAutorizacao[]

  criadoEm           DateTime           @default(now())
  atualizadoEm       DateTime           @updatedAt

  @@map("chamados")
}

model ChamadoFoto {
  id           String    @id @default(uuid())
  chamadoId    String
  chamado      Chamado   @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  url          String
  tipo         TipoFoto  @default(ANTES) // ANTES, DEPOIS, COMPROVANTE
  sha256       String?   // Prevenção de fotos duplicadas/falsas
  ordem        Int       @default(1)

  criadoEm     DateTime  @default(now())

  @@map("chamados_fotos")
}

model ChamadoInsumo {
  id               String          @id @default(uuid())
  chamadoId        String
  chamado          Chamado         @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  itemReferenciaId String?
  itemReferencia   ItemReferencia? @relation(fields: [itemReferenciaId], references: [id])

  tipoInsumo       TipoInsumo      @default(PREVISTO)
  codigo           String
  descricao        String
  unidadeMedida    String
  quantidade       Decimal         @db.Decimal(10, 3)
  valorUnitario    Decimal         @db.Decimal(12, 2)
  valorTotal       Decimal         @db.Decimal(12, 2)

  criadoEm         DateTime        @default(now())

  @@map("chamados_insumos")
}

model ChamadoAutorizacao {
  id            String   @id @default(uuid())
  chamadoId     String
  chamado       Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  parecer       String?  @db.Text
  aprovado      Boolean
  valorAprovado Decimal? @db.Decimal(12, 2)
  dataDecisao   DateTime @default(now())

  @@map("chamados_autorizacoes")
}

model Feriado {
  id          String   @id @default(uuid())
  data        DateTime @unique
  descricao   String
  abrangencia String   @default("NACIONAL")

  @@map("feriados")
}

model ParametroSistema {
  id        String   @id @default(uuid())
  chave     String   @unique
  valor     String
  descricao String?

  @@map("parametros_sistema")
}
